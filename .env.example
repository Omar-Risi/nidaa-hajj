# Postgres (Supabase). Pooled connection string used by the app at runtime.
DATABASE_URL=

# Direct (non-pooled) connection, used by `prisma migrate` only.
DIRECT_URL=

# Secret used to sign session JWTs. Required — there is no fallback.
JWT_SECRET=

# Supabase client credentials. NEXT_PUBLIC_* values are inlined at build time,
# so these must be present in the build environment, not only at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
