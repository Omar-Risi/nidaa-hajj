# ---------------------------------------------------------------------------
# Runtime (the deployed Worker). Set these with `wrangler secret put <NAME>`
# or in the Cloudflare dashboard. For local `wrangler dev`, put them in
# .dev.vars instead (see .dev.vars.example).
# ---------------------------------------------------------------------------

# Secret used to sign session JWTs. Required — there is no fallback.
JWT_SECRET=

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
# Falls back to NEXT_PUBLIC_SUPABASE_URL if unset.
SUPABASE_URL=

# Service-role key. Server-side only — it bypasses RLS, so never expose it to
# the browser and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Build time only. NEXT_PUBLIC_* values are inlined into the bundle during
# `next build`, so they must exist in the BUILD environment — setting them as
# Worker secrets alone does nothing.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Prisma. No longer used at runtime — the app talks to Supabase over HTTP so it
# can run on Workers. These are only needed locally for `prisma migrate` and the
# one-off *.mjs scripts in the repo root.
# ---------------------------------------------------------------------------

# Pooled connection (Supavisor, port 6543). Append ?pgbouncer=true
DATABASE_URL=

# Direct connection (port 5432), used by migrations.
DIRECT_URL=
